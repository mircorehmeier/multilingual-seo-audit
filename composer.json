{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "mircorehmeier/multilingual-seo-audit",
  "type": "project",
  "description": "Open-source multilingual technical SEO auditor built with Laravel.",
  "keywords": ["laravel", "seo", "hreflang", "multilingual-seo", "technical-seo"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "laravel/framework": "^13.17"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@php artisan test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
